{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@upgradelab/contracts": ["packages/contracts/src/index.ts"],
      "@upgradelab/config": ["packages/config/src/index.ts"],
      "@upgradelab/core": ["packages/core/src/index.ts"],
      "@upgradelab/assertion-engine": ["packages/assertion-engine/src/index.ts"],
      "@upgradelab/database-postgres": ["packages/database-postgres/src/index.ts"],
      "@upgradelab/docker-compose-provider": ["packages/docker-compose-provider/src/index.ts"],
      "@upgradelab/reporters": ["packages/reporters/src/index.ts"],
      "@upgradelab/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@upgradelab/ai-assistant": ["packages/ai-assistant/src/index.ts"],
      "@upgradelab/plugin-example-csv-reporter": ["examples/plugins/csv-reporter/src/index.ts"],
      "@upgradelab/cli": ["apps/cli/src/index.ts"]
    }
  }
}
