{
  "name": "@upgradelab/database-postgres",
  "version": "1.0.0-dev.0",
  "description": "Read-only PostgreSQL database adapter for UpgradeLab.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@upgradelab/contracts": "workspace:*",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
